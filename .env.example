# Coinbase Advanced Trade (Sandbox for paper trading)
COINBASE_API_KEY=your_coinbase_api_key_here
COINBASE_API_SECRET=your_coinbase_api_secret_here
COINBASE_PASSPHRASE=your_coinbase_passphrase_here
COINBASE_SANDBOX=1

# Alpaca (stocks paper trading)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# General Trading Configuration
USE_MARKET=crypto                    # crypto|stocks
DEFAULT_SYMBOL=BTC-USD
TIMEFRAME=5m
RISK_PER_TRADE=0.005                 # 0.5% equity per trade
MAX_DAILY_LOSS=0.02                  # 2% daily kill switch threshold
MAX_PORTFOLIO_EXPOSURE=0.4           # 40% max portfolio exposure
SYMBOL_WHITELIST=BTC-USD,ETH-USD

# Database
DATABASE_URL=sqlite:///./data/aurora_trader.db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Alerts (optional)
SLACK_WEBHOOK_URL=
EMAIL_SMTP_SERVER=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_ALERT_TO=

# Worker Configuration
WORKER_ENABLED=false
WORKER_CHECK_INTERVAL_SECONDS=300    # 5 minutes default
